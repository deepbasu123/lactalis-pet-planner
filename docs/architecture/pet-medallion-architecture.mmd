    classDef cGold fill:#FBF1D6,stroke:#B8912B,stroke-width:1px,color:#5C4813
    classDef cEngine fill:#EAF2FB,stroke:#2E6DA4,stroke-width:1.5px,color:#1B3A57
    classDef cConsumption fill:#EAF7F0,stroke:#2F8F5B,stroke-width:1px,color:#183E29
