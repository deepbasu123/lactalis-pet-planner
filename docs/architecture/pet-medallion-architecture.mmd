---
title: Lactalis NOVA PET Line Planner - Databricks Medallion Architecture
---
%%{init: {"htmlLabels": false, "themeCSS": ".edgeLabel rect { opacity: 1 !important; }", "flowchart": {"curve": "basis", "nodeSpacing": 40, "rankSpacing": 65, "padding": 20, "subGraphTitleMargin": {"top": 8, "bottom": 44}}}}%%
flowchart LR

    %% ================= SOURCE =================
    %% SYNTH declared first: dagre's cycle-breaking DFS starts from the
    %% first-inserted node, so leading with the edge that flows into the
    %% pipeline (SYNTH -> VOL) lets the whole Gold/Silver -> Consumption
    %% direction resolve as forward, leaving only App -> Volume as a
    %% back-edge instead of four.
    subgraph SRC["SOURCE"]
        SYNTH(["Synthetic Workbook<br/>Generator, demo<br/>data seed"])
        PLANNER(["Supply Planner"])
    end

    %% ================= GOVERNANCE WRAPPER: Unity Catalog =================
    %% Contains every catalog, schema, volume and table in the diagram,
    %% drawn as an outer container so governance reads as an underlying
    %% layer rather than a floating node.
    subgraph UCWRAP["UNITY CATALOG, governs every catalog, schema, volume and table below"]

        subgraph LAND["LANDING"]
            VOL[("UC Volume<br/>deep_test_1_catalog.<br/>lactalis_pet_bronze.landing<br/>uploads/")]
        end

        subgraph PIPE["LAKEFLOW DECLARATIVE PIPELINE, batch engine"]
            subgraph BRZ["BRONZE, lactalis_pet_bronze"]
                BZT["Raw workbook rows,<br/>openpyxl parse plus<br/>ingest metadata"]
            end

            subgraph SIL["SILVER, lactalis_pet_silver, conformed, typed, DQ-checked"]
                SVT["sku, week,<br/>parameter, demand,<br/>plan_line,<br/>opening_stock<br/>Expectations:<br/>week alignment,<br/>pack-size,<br/>active SKUs"]
            end

            subgraph GLD["GOLD, lactalis_pet_gold"]
                GRULES[["21 Business Rules, SQL<br/>projection: stock<br/>projection, 2-wk QA lag,<br/>floor-at-zero carryforward<br/>week_capacity:<br/>pack-size, SKU-count,<br/>ceiling, maintenance<br/>summary"]]
                GSNAP[("projection_snapshot<br/>run-stamped")]
                GRULES --> GSNAP
            end

            BZT --> SVT
            SVT -->|"batch, Lakeflow<br/>pipeline: runs<br/>Gold rule SQL"| GRULES
        end

        %% App-writable overlay: same silver schema, not pipeline-managed
        OVERLAY[("silver.plan_overlay<br/>app-writable edits,<br/>not pipeline-managed")]
    end

    %% ================= INTERACTIVE RECOMPUTE ENGINE =================
    WH{{"Serverless SQL<br/>Warehouse, interactive<br/>recompute, ~1-2 sec,<br/>invoked by the App<br/>on each edit"}}

    %% ================= CONSUMPTION: app plus Genie plus AI/BI =================
    subgraph CONS["CONSUMPTION"]
        subgraph APP["DATABRICKS APP, React + FastAPI, thin serving layer, zero business logic"]
            UI["React UI"]
            API["FastAPI Backend"]
            GENIE(["Genie<br/>proxied, embedded<br/>in UI"])
            UI --> API
            API --> GENIE
        end
        AIBI["AI/BI Dashboard"]
    end

    %% ================= EMPHASIS NOTE =================
    NOTE1["Same rule SQL,<br/>two callers:<br/>pipeline batch plus<br/>warehouse interactive"]

    %% ================= EDGES: source =================
    SYNTH -->|"seeds demo<br/>workbook direct to<br/>landing, same<br/>medallion path,<br/>no UI"| VOL
    PLANNER -->|"uploads PET<br/>Traffic Lights<br/>.xlsx workbook"| UI

    %% ================= EDGES: upload, write, trigger, ingest =================
    %% The one accepted back-edge: the app reaching back to write the
    %% upload and kick off the pipeline. Every other App interaction
    %% below is local/forward relative to this.
    API -.->|"writes .xlsx,<br/>triggers and polls<br/>pipeline run"| VOL
    VOL -->|"ingest"| BZT

    %% ================= EDGES: interactive recompute =================
    SVT -->|"reads plan_line<br/>for COALESCE"| WH
    WH -->|"MERGE into<br/>plan_overlay"| OVERLAY
    OVERLAY -->|"feeds<br/>COALESCE"| GRULES
    WH -->|"same rule SQL,<br/>2nd caller:<br/>recompute over<br/>COALESCE(overlay,<br/>plan_line)"| GRULES

    %% ================= EDGES: app reads, consumption =================
    GRULES -->|"reads"| API
    GLD --> CONS
    SIL --> CONS

    %% ================= EDGES: governance grant =================
    UCWRAP -.-|"grants to the App<br/>service principal"| APP

    %% ================= EDGES: emphasis note, no arrowhead =================
    WH -.- NOTE1

